# Server-side configuration for local development. Replace placeholders locally.
# Never commit real credentials or copy a production .env file into Git.
DATABASE_URL=postgres://RUNTIME_USER:RUNTIME_PASSWORD@localhost:5432/aicompany
# For a controlled migration job only; do not configure this on Vercel runtime:
# DATABASE_MIGRATION_URL=postgres://MIGRATION_OWNER:PASSWORD@localhost:5432/aicompany

# At least 32 random bytes, stable across serverless instances.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# bcrypt hash of a strong CEO password; never place the plaintext password here.
CEO_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# Required in production; must be exactly the verified HTTPS origin, no path.
# For previews, assign a separately approved stable preview hostname.
APP_ORIGIN=https://aicompany.example
